# =============================================================================
#  Configuración del Laboratorio 2 — copia este archivo a ".env" y edítalo.
#  (El archivo .env NUNCA se sube a git.)
# =============================================================================

# --- 1) PROVEEDOR DEL MODELO ---------------------------------------------------
#   anthropic -> modelos de PAGO de Anthropic (Claude), requiere API key
#   ollama    -> modelos LOCALES y GRATUITOS (levantar con --profile local)
LAB_PROVEEDOR=anthropic

# --- 2) MODELO -----------------------------------------------------------------
#   Anthropic: claude-haiku-4-5 (más barato) | claude-sonnet-5 (mejor calidad)
#   Ollama:    qwen2.5:3b (ligero) | qwen2.5:7b | llama3.1:8b
LAB_MODELO=claude-haiku-4-5

# --- 3) CREDENCIAL (SOLO si LAB_PROVEEDOR=anthropic) ---------------------------
ANTHROPIC_API_KEY=

# --- Opciones avanzadas (normalmente NO hay que tocarlas) ---------------------
LAB_OLLAMA_URL=http://ollama:11434/v1
# Máximo de pasos del ciclo del agente (el análisis de vulns da más pasos).
LAB_MAX_ITERACIONES=25
# Timeout por herramienta, en segundos (nikto y nmap --script vuln son lentos).
LAB_TIMEOUT_HERRAMIENTA=300
