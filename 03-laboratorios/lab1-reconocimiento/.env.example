# Copia este archivo a `.env` (en esta misma carpeta o en la raíz del lab,
# según se indique en la guía) y rellena tu clave real.
# El archivo .env NUNCA se sube a git (está en .gitignore).

# --- Credencial de la API de Anthropic (OBLIGATORIO) ---
# Générala en https://console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Configuración del agente (opcional; estos son los valores por defecto) ---
# Modelo a usar. Barato por defecto; cambia a claude-sonnet-5 para comparar.
LAB_MODELO=claude-haiku-4-5
# Máximo de iteraciones del ciclo ReAct (evita bucles infinitos).
LAB_MAX_ITERACIONES=20
# Timeout por herramienta, en segundos.
LAB_TIMEOUT_HERRAMIENTA=180
